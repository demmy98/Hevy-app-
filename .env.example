# Hevy Pro API key: https://hevy.com/settings?developer
HEVY_API_KEY=
# Anthropic API key (only used when you press "Generate today's plan")
ANTHROPIC_API_KEY=
# Login password for the app
APP_PASSWORD=
# Random string, 32+ chars, used to sign the login cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Token the Apple Shortcut sends to /api/health (e.g. `openssl rand -hex 24`)
HEALTH_INGEST_TOKEN=
# Database: leave unset locally (uses ./local.db). In production use Turso:
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Your time zone (IANA name)
APP_TIMEZONE=Europe/London
